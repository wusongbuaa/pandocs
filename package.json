{
  "name": "pandocs",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter @pandocs/web build && pnpm --filter @pandocs/embed build && pnpm --filter @pandocs/server build",
    "dev": "pnpm --filter @pandocs/server dev",
    "typecheck": "tsc --noEmit && tsc -p packages/web --noEmit",
    "lint": "oxlint --quiet",
    "test": "vitest run",
    "test:e2e": "PANDOCS_E2E=1 vitest run --project e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.1",
    "happy-dom": "^21.0.4",
    "oxlint": "1.89.0",
    "pg": "^8.21.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
