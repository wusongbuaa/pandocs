# What every editor should agree on. How lines are wrapped is left to the code around them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.py]
indent_size = 4

[*.md]
# Two spaces at the end of a line are a line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,go.mod,go.sum}]
indent_style = tab

[packages/web/vendor/**]
# A verbatim copy of the Rspress theme, kept as it came.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
