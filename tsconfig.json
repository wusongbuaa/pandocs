{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest"],
    "jsx": "react-jsx",
    "paths": {
      "@pandocs/client": ["./packages/client/src/index.ts"],
      "@pandocs/embed": ["./packages/embed/src/index.ts"],
      "@pandocs/editor-model": ["./packages/editor-model/src/index.ts"],
      "@pandocs/i18n": ["./packages/i18n/src/index.ts"],
      "@pandocs/markdown/zh": ["./packages/markdown/src/i18n/zh.ts"],
      "@pandocs/markdown/issue-message": ["./packages/markdown/src/issue-message.ts"],
      "@pandocs/markdown": ["./packages/markdown/src/index.ts"],
      "@pandocs/core": ["./packages/core/src/index.ts"],
      "@pandocs/core/migrate": ["./packages/core/src/infrastructure/migrate.ts"],
      "@pandocs/core/s3-asset-store": ["./packages/core/src/infrastructure/s3-asset-store.ts"]
    }
  },
  "exclude": ["packages/web", "node_modules", "**/dist"],
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "test/**/*.ts", "vitest.config.ts"]
}
