# Everything here is optional for a trial. Copy to .env to use it with `docker compose up`.

# For Docker Compose. Choose the database's password before the first start: it is set when the database is created,
# and changing it here later does not change it there. Only Pandocs can reach the database, but a real password is
# still the one to have.
# POSTGRES_PASSWORD=
# The port on this machine the site answers on.
# PANDOCS_PORT=8080

# The address people use. Sign-in redirects and links in mail are built from it. It can have a path, such as
# https://example.com/docs, for a site that lives below one on another site's host. See docs/deploying.md.
# PANDOCS_URL=https://docs.example.com
# PANDOCS_SITE_TITLE=Team docs

# Signs the short-lived cookie of a login in progress. Generated and kept in the database when unset.
# PANDOCS_SECRET=

# Which work this process does. Split them to scale web and background work separately.
# web serves pages and the API, worker runs background jobs, publisher writes the shared directory below.
# PANDOCS_ROLES=web,worker
# How long to keep answering after being told to stop, while load balancers catch up.
# PANDOCS_DRAIN_SECONDS=5
# PANDOCS_DATABASE_POOL=10
# LISTEN and session locks need a real connection; point this past a pooler in transaction mode.
# PANDOCS_DATABASE_LISTEN_URL=
# Set behind a proxy that sets X-Forwarded-For. With more than one in front, the number of them.
# PANDOCS_TRUST_PROXY=true

# Create the first administrator without going through the setup page.
# PANDOCS_ADMIN_EMAIL=admin@example.com
# PANDOCS_ADMIN_PASSWORD=
# PANDOCS_ADMIN_NAME=Admin
# PANDOCS_PASSWORD_LOGIN=true

# OpenID Connect: any provider with a discovery document.
# The redirect URI to register with the provider is <PANDOCS_URL>/auth/oidc/callback
# PANDOCS_OIDC_ISSUER=https://id.example.com
# PANDOCS_OIDC_CLIENT_ID=
# PANDOCS_OIDC_CLIENT_SECRET=
# PANDOCS_OIDC_NAME=Company account
# PANDOCS_OIDC_SCOPES=openid profile email groups
# PANDOCS_OIDC_GROUPS_CLAIM=groups
# PANDOCS_OIDC_ADMIN_GROUP=docs-admins
# PANDOCS_OIDC_ALLOWED_DOMAINS=example.com

# Signing in with the session of the site this one lives beside, for a site below its path (PANDOCS_URL above). The
# browser sends its cookie here too, and that site's address below says who it belongs to, in JSON. Nobody signs in
# again and there are no accounts to keep: they are made on first sight and follow what the host says. Paths such as
# data.user.id reach into the answer. {url} in the login address is the page to come back to.
# PANDOCS_HOST_SESSION_URL=http://main.internal/api/me
# PANDOCS_HOST_SESSION_COOKIES=SESSION_ID
# PANDOCS_HOST_NAME=Main site
# PANDOCS_HOST_LOGIN_URL=https://example.com/login?redirect={url}
# PANDOCS_HOST_LOGOUT_URL=https://example.com/logout
# PANDOCS_HOST_SUBJECT_CLAIM=id
# PANDOCS_HOST_EMAIL_CLAIM=email
# PANDOCS_HOST_NAME_CLAIM=name
# PANDOCS_HOST_GROUPS_CLAIM=roles
# PANDOCS_HOST_ADMIN_GROUP=admin
# How long an answer counts, which is also how long signing out there takes to reach here.
# PANDOCS_HOST_SESSION_SECONDS=60

# Plain OAuth2, for providers without OpenID Connect.
# The redirect URI is <PANDOCS_URL>/auth/oauth/callback
# PANDOCS_OAUTH_AUTHORIZATION_URL=
# PANDOCS_OAUTH_TOKEN_URL=
# PANDOCS_OAUTH_USERINFO_URL=
# PANDOCS_OAUTH_CLIENT_ID=
# PANDOCS_OAUTH_CLIENT_SECRET=
# PANDOCS_OAUTH_NAME=
# PANDOCS_OAUTH_SCOPES=
# PANDOCS_OAUTH_SUBJECT_CLAIM=id
# PANDOCS_OAUTH_EMAIL_CLAIM=email
# PANDOCS_OAUTH_NAME_CLAIM=name
# PANDOCS_OAUTH_GROUPS_CLAIM=groups
# PANDOCS_OAUTH_ADMIN_GROUP=
# PANDOCS_OAUTH_ALLOWED_DOMAINS=

# Space administrators can open a space to people with no login. Set this to false to rule that out for the whole site.
# PANDOCS_PUBLIC_SPACES=true

# Pages leave the server finished, for readers and for search engines and agents that run no scripts. Set this to false
# to have the browser render them instead. A page that fails to render on the server falls back to that by itself.
# PANDOCS_RENDER_PAGES=true

# How much pages are read, what is searched for and what the AI is asked, for those who look after the documents. These
# are counts, with nothing about who: no addresses, cookies or names. Set this to false to keep none of it.
# PANDOCS_READING_STATS=true

# Webhooks cannot reach private networks unless this is on. See docs/webhooks.md.
# PANDOCS_WEBHOOK_ALLOW_PRIVATE=false

# People editing a page share one draft and see each other type, over a WebSocket at /api/v1/live. See docs/live-editing.md.
# PANDOCS_LIVE_EDITING=true
# How soon someone connected to a draft is sent away after they can no longer edit it.
# PANDOCS_LIVE_RECHECK_SECONDS=30

# Git sync can only reach public addresses unless you say otherwise, for a Git host inside your own network.
# PANDOCS_GIT_ALLOW_PRIVATE=false

# Importing from Feishu or Lark goes through an app of yours there. See docs/importing-files.md. Anyone who can edit a
# space can bring in whatever this app can read, so give it access only to what you are happy with.
# PANDOCS_FEISHU_APP_ID=
# PANDOCS_FEISHU_APP_SECRET=
# PANDOCS_FEISHU_BASE_URL=https://open.feishu.cn

# Files. Local storage works for one machine or a shared volume; anything speaking the S3 API works everywhere.
# Credentials come from the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# PANDOCS_STORAGE=s3
# PANDOCS_S3_BUCKET=
# PANDOCS_S3_REGION=
# PANDOCS_S3_ENDPOINT=
# PANDOCS_S3_PREFIX=pandocs/
# PANDOCS_S3_FORCE_PATH_STYLE=false
# Without S3, files go in this directory. The image uses /data, which Docker Compose keeps in the data volume.
# PANDOCS_DATA_DIR=./data

# Keep a read-only copy of spaces as files on a shared file system (NFS, CFS, EFS, NAS), for agents to mount.
# Anyone with the mount can read it, so spaces are listed on purpose; restricted pages are never published.
# A worker publishes from a process of its own, so a hung mount only delays the files. To keep the mount off the
# replicas serving pages, give it to one or two with PANDOCS_ROLES=publisher, and leave this unset on the rest.
# PANDOCS_PUBLISH_DIR=/mnt/shared/pandocs
# PANDOCS_PUBLISH_SPACES=handbook,guide
# PANDOCS_PUBLISH_PACK_SECONDS=300

# Files other than Markdown are converted when imported. Word, Excel, PowerPoint, PDF, HTML and CSV work out of the box.
# For scanned PDFs, old Office files or better layout, point this at a service that takes a file and answers with Markdown.
# PANDOCS_EXTRACT_URL=
# PANDOCS_EXTRACT_TOKEN=
# Only what the built-in conversion cannot read goes to the service: scans and old Office formats.
# PANDOCS_EXTRACT_FALLBACK=false
# The converter in deploy/converter, with Docker Compose (docs/importing-files.md):
# COMPOSE_PROFILES=converter,docling
# DOCLING_URL=http://docling:5001

# Model for summaries and the selection toolbar. Off without a key.
# PANDOCS_LLM_PROTOCOL=anthropic
# PANDOCS_LLM_API_KEY=
# PANDOCS_LLM_MODEL=claude-opus-5-5
# PANDOCS_LLM_BASE_URL=
# Headers for every model call, as a JSON object, for a gateway that is told what to do by header.
# PANDOCS_LLM_HEADERS={"x-portkey-provider":"anthropic"}
# PANDOCS_LLM_HOURLY_LIMIT=60
# For everyone with no login taken together, once a site lets them ask the AI (Site settings):
# PANDOCS_LLM_VISITOR_HOURLY_LIMIT=60
# Or any service with an OpenAI-compatible API:
# PANDOCS_LLM_PROTOCOL=openai
# PANDOCS_LLM_BASE_URL=https://api.example.com/v1

# Mail for mentions, invitations and forgotten passwords. Without a host, administrators pass on password links themselves.
# PANDOCS_SMTP_HOST=
# PANDOCS_SMTP_PORT=587
# PANDOCS_SMTP_USER=
# PANDOCS_SMTP_PASSWORD=
# PANDOCS_SMTP_FROM=docs@example.com
